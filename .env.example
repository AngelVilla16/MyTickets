# Base de datos MySQL
DB_HOST=localhost
DB_USER=usuario
DB_PASSWORD=contrasena
DB_NAME=mytickets
DB_PORT=3306

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_largo

# Correos con permiso de "jefe" (separados por coma).
# Solo estos correos pueden asignar tickets.
JEFES_EMAILS=jefe@empresa.com
